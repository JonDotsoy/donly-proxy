    "type": "request",
    "url": "http://spawnlog.test/ssh",
  },
  {
    "args": [
      "-p",
      "2222",
      "-T",
      "-q",
      "-o",
      "BatchMode=yes",
      "user@remote.test",
      
"d=$(mktemp -d) && trap 'rm -rf "$d"' EXIT && printf %s 'dXJsID0gImh0dHA6Ly9zcGF3bmxvZy50ZXN0L3NzaCIKcmVxdWVzdCA9ICJHRVQiCmhlYWRlciA9ICJ1c2VyLWFnZW50OiBkb25seS10ZXN0IgpoZWFkZXIgPSAiYWNjZXB0OiAqLyoi' | base64 -d > "$d/c" && curl -K "$d/c" '--silent' '--compressed' '--proto' '=http,https' '--write-out' '%{stderr}%{response_code}
%{header_json}' '--header' 'Expect:' '--output' '-'"
,
    ],
    "command": [
      "ssh",
      "-p",
      "2222",
      "-T",
      "-q",
      "-o",
      "BatchMode=yes",
      "user@remote.test",
      
"d=$(mktemp -d) && trap 'rm -rf "$d"' EXIT && printf %s 'dXJsID0gImh0dHA6Ly9zcGF3bmxvZy50ZXN0L3NzaCIKcmVxdWVzdCA9ICJHRVQiCmhlYWRlciA9ICJ1c2VyLWFnZW50OiBkb25seS10ZXN0IgpoZWFkZXIgPSAiYWNjZXB0OiAqLyoi' | base64 -d > "$d/c" && curl -K "$d/c" '--silent' '--compressed' '--proto' '=http,https' '--write-out' '%{stderr}%{response_code}
%{header_json}' '--header' 'Expect:' '--output' '-'"
,
    ],
    "http_version": "HTTP/1.1",
    "method": "GET",
