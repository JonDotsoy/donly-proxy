exports[`should match the snapshot of the log lines of an ssh ShellRequest 1`] = `
[
  {
    "headers": {
      "accept": "*/*",
      "accept-encoding": "gzip, deflate, br, zstd",
      "connection": "keep-alive",
      "host": "spawnlog.test",
      "proxy-connection": "Keep-Alive",
      "user-agent": "donly-test",
    },
    "http_version": "HTTP/1.1",
    "method": "GET",
    "payload": "",
