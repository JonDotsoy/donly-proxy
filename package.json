{
  "name": "donly-proxy",
  "type": "module",
  "version": "0.0.20",
  "scripts": {
    "start": "bun src/cli/main.ts manifest.donly",
    "build": "bun build src/cli/main.ts --outfile dist/donly-proxy.js --target bun",
    "test": "bun test",
    "features": "bun scripts/features.ts",
    "features:check": "bun scripts/features.ts --check",
    "e2e": "bun run build && bun test --timeout 60000 ./e2e/ui.e2e.ts ./e2e/multi-proxy.e2e.ts ./e2e/route-url-formats.e2e.ts ./e2e/no-route.e2e.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright-core": "1.56.1"
  },
  "dependencies": {
    "@jondotsoy/flags": "^3.2.1",
    "donly": "^0.0.32"
  }
}
